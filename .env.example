# Names only. Real values live in Vercel; run `vercel env pull .env.local` to get them locally.
DATABASE_URL=            # Neon pooled connection (app runtime)
DATABASE_URL_UNPOOLED=   # Neon direct connection (migrations)
BETTER_AUTH_SECRET=      # random 32-byte secret for signing sessions
ADMIN_EMAIL=             # this email becomes an admin when it registers
BLOB_READ_WRITE_TOKEN=   # private Vercel Blob store for uploaded learning plans
EXTRACTION_MODEL=        # optional AI Gateway model id; defaults to anthropic/claude-sonnet-5.5
RESEND_API_KEY=          # optional: Resend API key; turns on password-reset and confirmation emails
EMAIL_FROM=              # optional: sender on a domain verified in Resend, e.g. "ARC <no-reply@yourdomain.com>"
GOOGLE_CLIENT_ID=        # optional: Google OAuth client; turns on "Continue with Google"
GOOGLE_CLIENT_SECRET=    # redirect URI: https://american-renewal-corps-pitch.vercel.app/api/auth/callback/google
