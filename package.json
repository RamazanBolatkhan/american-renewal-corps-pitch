  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "ai": "7.0.126",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
